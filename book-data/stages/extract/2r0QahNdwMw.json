        ]
      },
      {
        "id": "2r0QahNdwMw:p032",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "claim",
        "importance": 1,
        "text": "In this example, layer_sizes has six elements indexed from 0 to 5.",
