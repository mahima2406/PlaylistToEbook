          "2r0QahNdwMw@1583",
          "2r0QahNdwMw@1584",
          "2r0QahNdwMw@1587",
          "2r0QahNdwMw@1589",
          "2r0QahNdwMw@1591"
        ]
      },
      {
        "id": "2r0QahNdwMw:p045",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "definition",
        "importance": 2,
        "text": "In PyTorch, the backward method conveniently computes loss gradients during the backward pass.",
        "line_ids": [
          "2r0QahNdwMw@1630",
          "2r0QahNdwMw@1633",
          "2r0QahNdwMw@1635",
          "2r0QahNdwMw@1637",
          "2r0QahNdwMw@1640",
          "2r0QahNdwMw@1642",
          "2r0QahNdwMw@1644",
          "2r0QahNdwMw@1646",
          "2r0QahNdwMw@1649",
          "2r0QahNdwMw@1650",
          "2r0QahNdwMw@1653",
          "2r0QahNdwMw@1655"
        ]
      },
      {
        "id": "2r0QahNdwMw:p046",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "claim",
        "importance": 3,
        "text": "Without shortcut connections, the mean gradient becomes much smaller in earlier layers, illustrating the vanishing gradient problem.",
        "line_ids": [
          "2r0QahNdwMw@1658",
          "2r0QahNdwMw@1659",
          "2r0QahNdwMw@1662",
          "2r0QahNdwMw@1665",
          "2r0QahNdwMw@1668",
          "2r0QahNdwMw@1670",
          "2r0QahNdwMw@1672",
          "2r0QahNdwMw@1675",
          "2r0QahNdwMw@1676",
          "2r0QahNdwMw@1679",
          "2r0QahNdwMw@1681",
          "2r0QahNdwMw@1683",
          "2r0QahNdwMw@1685"
        ]
      },
      {
        "id": "2r0QahNdwMw:p047",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "claim",
        "importance": 3,
        "text": "Adding shortcut connections creates alternative paths for gradients to flow between layers.",
        "line_ids": [
          "2r0QahNdwMw@1690",
          "2r0QahNdwMw@1692",
          "2r0QahNdwMw@1694",
          "2r0QahNdwMw@1696",
          "2r0QahNdwMw@1700",
          "2r0QahNdwMw@1702",
