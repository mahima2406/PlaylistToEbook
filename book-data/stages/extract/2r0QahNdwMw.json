      },
      {
        "id": "2r0QahNdwMw:p037",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "code",
        "importance": 3,
        "text": "The shortcut connection is implemented by a single line that updates x to x plus the layer output.",
        "line_ids": [
