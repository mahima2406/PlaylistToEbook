        ]
      },
      {
        "id": "2r0QahNdwMw:p040",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "claim",
        "importance": 3,
        "text": "In layers with input dimension 3 and output dimension 3, each neuron has three weights, so the weight matrix is 3 by 3, while the final layer has a 3 by 1 weight matrix.",
        "line_ids": [
          "2r0QahNdwMw@1446",
          "2r0QahNdwMw@1448",
          "2r0QahNdwMw@1449",
          "2r0QahNdwMw@1452",
          "2r0QahNdwMw@1457",
          "2r0QahNdwMw@1458",
          "2r0QahNdwMw@1460",
          "2r0QahNdwMw@1462",
          "2r0QahNdwMw@1467",
          "2r0QahNdwMw@1470",
          "2r0QahNdwMw@1472",
          "2r0QahNdwMw@1474",
          "2r0QahNdwMw@1476",
          "2r0QahNdwMw@1478",
