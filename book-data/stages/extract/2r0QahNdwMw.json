          "2r0QahNdwMw@1239"
        ]
      },
      {
        "id": "2r0QahNdwMw:p035",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "procedure",
        "importance": 3,
        "text": "Without shortcut connections, the forward pass feeds each layer's output as the input to the next layer until the final output is produced.",
