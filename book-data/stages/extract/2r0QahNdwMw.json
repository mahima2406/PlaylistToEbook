        ]
      },
      {
        "id": "2r0QahNdwMw:p039",
        "video_id": "2r0QahNdwMw",
        "lecture": 22,
        "kind": "code",
        "importance": 2,
        "text": "The example first initializes a network without shortcut connections using layer sizes 3, 3, 3, 3, and 1, with a three-dimensional sample input [1, 0, -1].",
