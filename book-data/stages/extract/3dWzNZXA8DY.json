        "id": "3dWzNZXA8DY:p035",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 3,
        "text": "A rule-based chatbot is not machine learning because it does not learn from user responses and behaves the same for different users.",
