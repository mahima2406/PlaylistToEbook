          "3dWzNZXA8DY@1143",
          "3dWzNZXA8DY@1145",
          "3dWzNZXA8DY@1146",
          "3dWzNZXA8DY@1149",
          "3dWzNZXA8DY@1152",
          "3dWzNZXA8DY@1154",
          "3dWzNZXA8DY@1156"
        ]
      },
      {
        "id": "3dWzNZXA8DY:p034",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "analogy",
        "importance": 2,
        "text": "A rule-based chatbot can be an example of artificial intelligence without being an example of machine learning.",
