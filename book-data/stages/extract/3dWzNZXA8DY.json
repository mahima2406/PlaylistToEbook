          "3dWzNZXA8DY@1127",
          "3dWzNZXA8DY@1130",
          "3dWzNZXA8DY@1132"
        ]
      },
      {
        "id": "3dWzNZXA8DY:p033",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "definition",
        "importance": 3,
        "text": "Artificial intelligence is the broad category that includes machines showing human-like intelligent behavior.",
        "line_ids": [
