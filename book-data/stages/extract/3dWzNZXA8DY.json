        "id": "3dWzNZXA8DY:p038",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "analogy",
        "importance": 2,
        "text": "A decision tree used to predict heart disease is an example of machine learning but not deep learning because it does not use neural networks.",
