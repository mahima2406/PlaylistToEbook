        "id": "3dWzNZXA8DY:p044",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "definition",
        "importance": 3,
        "text": "Generative AI uses deep neural networks to create new content such as text, images, and other media, whereas large language models deal only with text.",
