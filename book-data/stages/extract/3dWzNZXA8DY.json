        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "visual_ref",
        "importance": 2,
        "text": "The Transformer schematic contains components such as input embedding, multi-head attention, feed-forward layers, add and norm, and output embedding.",
