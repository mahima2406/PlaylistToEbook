          "3dWzNZXA8DY@933",
          "3dWzNZXA8DY@939",
          "3dWzNZXA8DY@941",
          "3dWzNZXA8DY@943",
          "3dWzNZXA8DY@945",
          "3dWzNZXA8DY@947"
        ]
      },
      {
        "id": "3dWzNZXA8DY:p032",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 3,
        "text": "Artificial intelligence is the broadest umbrella, machine learning is a subset of artificial intelligence, deep learning is a subset of machine learning, and large language models are a subset of deep learning.",
