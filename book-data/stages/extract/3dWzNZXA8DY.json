        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 2,
        "text": "Deep neural networks have many applications, including image detection, text generation, self-driving cars, and detecting whether a patient has a brain tumor.",
