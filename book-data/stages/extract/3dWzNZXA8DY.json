        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 3,
        "text": "Deep learning is a subset of machine learning because machine learning includes neural network methods and also methods that are not neural networks, such as decision trees.",
        "line_ids": [
