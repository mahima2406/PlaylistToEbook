          "3dWzNZXA8DY@976"
        ]
      },
      {
        "id": "3dWzNZXA8DY:p029",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 2,
        "text": "The paper \"Attention Is All You Need\" had more than 100,000 citations in about five years.",
        "line_ids": [
          "3dWzNZXA8DY@981",
