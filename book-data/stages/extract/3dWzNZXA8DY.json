          "3dWzNZXA8DY@986",
          "3dWzNZXA8DY@990"
        ]
      },
      {
        "id": "3dWzNZXA8DY:p030",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "claim",
        "importance": 2,
        "text": "The paper \"Attention Is All You Need\" is dense, and understanding it takes a lot of time and effort.",
        "line_ids": [
          "3dWzNZXA8DY@1009",
          "3dWzNZXA8DY@1012",
          "3dWzNZXA8DY@1015",
          "3dWzNZXA8DY@1017"
        ]
      },
