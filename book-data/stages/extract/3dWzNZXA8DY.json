        "id": "3dWzNZXA8DY:p028",
        "video_id": "3dWzNZXA8DY",
        "lecture": 2,
        "kind": "definition",
        "importance": 3,
        "text": "A Transformer is a neural network architecture introduced in the 2017 paper \"Attention Is All You Need.\"",
        "line_ids": [
