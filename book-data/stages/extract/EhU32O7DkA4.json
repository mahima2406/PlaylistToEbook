        ]
      },
      {
        "id": "EhU32O7DkA4:p035",
        "video_id": "EhU32O7DkA4",
        "lecture": 30,
        "kind": "claim",
        "importance": 2,
        "text": "The lecturer presents a temperature of 1.4 as a good trade-off.",
        "line_ids": [
          "EhU32O7DkA4@1120",
          "EhU32O7DkA4@1128",
          "EhU32O7DkA4@1131",
