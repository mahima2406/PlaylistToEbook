      },
      {
        "id": "EhU32O7DkA4:p036",
        "video_id": "EhU32O7DkA4",
        "lecture": 30,
        "kind": "claim",
        "importance": 2,
        "text": "Using the new generate function produced output that differed from the earlier output generated by greedy decoding.",
        "line_ids": [
          "EhU32O7DkA4@1134",
          "EhU32O7DkA4@1137",
          "EhU32O7DkA4@1139",
          "EhU32O7DkA4@1141",
          "EhU32O7DkA4@1143",
          "EhU32O7DkA4@1144",
