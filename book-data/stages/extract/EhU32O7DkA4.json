      },
      {
        "id": "EhU32O7DkA4:p045",
        "video_id": "EhU32O7DkA4",
        "lecture": 30,
        "kind": "procedure",
        "importance": 3,
        "text": "The workflow to predict the next token is: obtain the logit tensor from the GPT model, apply top-k sampling, replace non-top-k logits with negative infinity, divide the logits by the temperature, apply softmax, and sample from the multinomial distribution.",
        "line_ids": [
