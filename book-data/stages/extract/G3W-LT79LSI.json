          "G3W-LT79LSI@1244",
          "G3W-LT79LSI@1250",
          "G3W-LT79LSI@1263",
          "G3W-LT79LSI@1266",
          "G3W-LT79LSI@1279",
          "G3W-LT79LSI@1281",
          "G3W-LT79LSI@1283"
