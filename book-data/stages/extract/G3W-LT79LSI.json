        "video_id": "G3W-LT79LSI",
        "lecture": 20,
        "kind": "claim",
        "importance": 3,
        "text": "Using keepdim equal to true preserves the mean as a 2 by 1 matrix instead of reducing it to a vector, which helps keep dimensions aligned for later calculations.",
