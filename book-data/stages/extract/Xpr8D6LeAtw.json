        "video_id": "Xpr8D6LeAtw",
        "lecture": 1,
        "kind": "claim",
        "importance": 2,
        "text": "Some available YouTube courses are too short, too complex for beginners, or not explained clearly from scratch, so they do not meet the need for a deep beginner-friendly course.",
