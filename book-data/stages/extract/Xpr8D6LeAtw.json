          "Xpr8D6LeAtw@647"
        ]
      },
      {
        "id": "Xpr8D6LeAtw:p022",
        "video_id": "Xpr8D6LeAtw",
        "lecture": 1,
        "kind": "claim",
        "importance": 3,
        "text": "A learner who wants real understanding should look for a deep course on foundations, not a quick crash course, because that depth builds confidence and improves interview readiness.",
        "line_ids": [
          "Xpr8D6LeAtw@652",
          "Xpr8D6LeAtw@654",
          "Xpr8D6LeAtw@656",
          "Xpr8D6LeAtw@659",
