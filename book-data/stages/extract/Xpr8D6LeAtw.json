        "video_id": "Xpr8D6LeAtw",
        "lecture": 1,
        "kind": "definition",
        "importance": 2,
        "text": "LangChain is a tool that helps build LLM applications.",
        "line_ids": [
          "Xpr8D6LeAtw@858",
