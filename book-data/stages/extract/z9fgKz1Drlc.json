          "z9fgKz1Drlc@473",
          "z9fgKz1Drlc@476",
          "z9fgKz1Drlc@480",
          "z9fgKz1Drlc@482",
          "z9fgKz1Drlc@484",
          "z9fgKz1Drlc@486",
          "z9fgKz1Drlc@488"
        ]
      },
      {
        "id": "z9fgKz1Drlc:p020",
        "video_id": "z9fgKz1Drlc",
        "lecture": 6,
        "kind": "procedure",
        "importance": 2,
        "text": "Stage two also includes model evaluation and loading pretrained weights.",
