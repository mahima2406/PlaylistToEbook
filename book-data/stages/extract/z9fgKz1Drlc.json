      },
      {
        "id": "z9fgKz1Drlc:p026",
        "video_id": "z9fgKz1Drlc",
        "lecture": 6,
        "kind": "claim",
        "importance": 2,
        "text": "The playlist will build two fine-tuned applications: a classifier and a personal assistant.",
        "line_ids": [
          "z9fgKz1Drlc@573",
          "z9fgKz1Drlc@575",
          "z9fgKz1Drlc@577",
