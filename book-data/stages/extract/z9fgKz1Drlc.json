      },
      {
        "id": "z9fgKz1Drlc:p019",
        "video_id": "z9fgKz1Drlc",
        "lecture": 6,
        "kind": "procedure",
        "importance": 3,
        "text": "In the training procedure, the training dataset is broken into epochs, the gradient of the loss is computed in each epoch, the parameters are updated, and sample text is generated for visual inspection.",
        "line_ids": [
