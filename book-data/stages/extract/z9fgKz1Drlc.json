        "id": "z9fgKz1Drlc:p022",
        "video_id": "z9fgKz1Drlc",
        "lecture": 6,
        "kind": "claim",
        "importance": 2,
        "text": "Saving and loading weights saves a lot of computational cost and memory.",
        "line_ids": [
