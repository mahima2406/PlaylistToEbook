          "z9fgKz1Drlc@549",
          "z9fgKz1Drlc@550",
          "z9fgKz1Drlc@552"
        ]
      },
      {
        "id": "z9fgKz1Drlc:p025",
        "video_id": "z9fgKz1Drlc",
        "lecture": 6,
        "kind": "claim",
        "importance": 3,
        "text": "Stage three focuses on fine-tuning the large language model to build specific applications.",
        "line_ids": [
          "z9fgKz1Drlc@562",
          "z9fgKz1Drlc@565",
          "z9fgKz1Drlc@567",
          "z9fgKz1Drlc@569",
          "z9fgKz1Drlc@571",
