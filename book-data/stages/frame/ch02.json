              "ghCSGRgVB_o@139",
              "ghCSGRgVB_o@141",
              "ghCSGRgVB_o@143",
              "ghCSGRgVB_o@146"
            ]
          }
        ]
      },
      {
        "id": "ch02.glance.p03",
        "sentences": [
          {
            "id": "ch02.glance.p03.01",
            "text": "There are three tokenization families here: word-based, subword-based, and character-based tokenizers.",
            "type": "F",
            "cites": [
              "fKd8s29e-l4@177",
              "fKd8s29e-l4@179",
              "fKd8s29e-l4@182",
              "fKd8s29e-l4@185",
              "fKd8s29e-l4@188",
              "fKd8s29e-l4@191"
            ]
          }
        ]
      },
      {
        "id": "ch02.glance.p04",
        "sentences": [
          {
            "id": "ch02.glance.p04.01",
            "text": "A word-based tokenizer usually treats each word as one token, but a simple split on whitespace is not enough because punctuation should often be separated and whitespace tokens may need to be removed.",
            "type": "F",
            "cites": [
