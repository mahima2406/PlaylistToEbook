      },
      {
        "id": "ch03.glance.p03",
        "sentences": [
          {
            "id": "ch03.glance.p03.01",
            "text": "Attention converts input embeddings into context vectors, and each context vector keeps token meaning while also encoding how that token relates to the other words in the sentence.",
            "type": "F",
            "cites": [
              "eSRhpYLerw4@305",
