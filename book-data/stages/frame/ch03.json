              "eSRhpYLerw4@229"
            ]
          }
        ]
      },
      {
        "id": "ch03.glance.p02",
        "sentences": [
          {
            "id": "ch03.glance.p02.01",
            "text": "An input embedding carries the meaning of a word itself, but it does not carry information about how that word relates to the other words in the sentence.",
            "type": "F",
            "cites": [
              "eSRhpYLerw4@250",
              "eSRhpYLerw4@253",
              "eSRhpYLerw4@255",
              "eSRhpYLerw4@272",
