      },
      {
        "id": "ch03.glance.p04",
        "sentences": [
          {
            "id": "ch03.glance.p04.01",
            "text": "For a given query token, attention scores are computed against every input token using the dot product, and higher dot products mean the vectors are more aligned and therefore receive higher attention.",
