            ]
          }
        ]
      },
      {
        "id": "ch02.s03.p06",
        "sentences": [
          {
            "id": "ch02.s03.p06.r01",
            "text": "With the class defined, you can instantiate it and test both directions of the mapping.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch02.s03.p06.r02",
            "text": "The tokenizer instance is created by passing in the previously defined vocabulary.",
