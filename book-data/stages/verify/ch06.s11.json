      {
        "id": "ch06.s11.p05",
        "sentences": [
          {
            "id": "ch06.s11.p05.r01",
            "text": "After the evaluation file is prepared, preserving the trained model avoids repeating the expensive fine-tuning run.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch06.s11.p05.r02",
            "text": "The fine-tuned model should be saved so the session can be resumed later without fine-tuning again.",
