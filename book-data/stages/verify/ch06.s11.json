        "id": "ch06.s11.p04",
        "sentences": [
          {
            "id": "ch06.s11.p04.r01",
            "text": "Next, collect model responses for all instructions in the test dataset and store them in a separate file for evaluation.",
            "type": "F",
            "cites": [
              "7m2jV7BOFkA@1100",
              "7m2jV7BOFkA@1103",
