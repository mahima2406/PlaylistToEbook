            ]
          }
        ]
      },
      {
        "id": "ch01.s04.p04",
        "sentences": [
          {
            "id": "ch01.s04.p04.01",
            "text": "The remaining categories broaden the range further.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch01.s04.p04.02",
            "text": "Machine translation is the use of large language models to translate text into other languages.",
            "type": "F",
            "cites": [
              "3dWzNZXA8DY@1690",
