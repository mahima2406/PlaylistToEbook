        "sentences": [
          {
            "id": "ch01.s04.p06.01",
            "text": "The broader motivation is not only technical but also practical.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch01.s04.p06.02",
            "text": "Large language models and generative AI are changing many things around us, including applications provided to teachers.",
