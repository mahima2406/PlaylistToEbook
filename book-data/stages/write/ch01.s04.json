              "3dWzNZXA8DY@1629",
              "3dWzNZXA8DY@1631",
              "3dWzNZXA8DY@1632"
            ]
          },
          {
            "id": "ch01.s04.p03.06",
            "text": "Chatbots are a huge and major application for airlines, hotel reservation desks, banks, movie and restaurant services, and customer support.",
            "type": "F",
            "cites": [
              "3dWzNZXA8DY@1634",
              "3dWzNZXA8DY@1638",
              "3dWzNZXA8DY@1641",
