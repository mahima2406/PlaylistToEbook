      {
        "id": "ch02.s10.p05",
        "sentences": [
          {
            "id": "ch02.s10.p05.01",
            "text": "Semantic meaning is not the whole story, however.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch02.s10.p05.02",
            "text": "The vector embeddings discussed so far do not encode the position of a word in a sentence.",
