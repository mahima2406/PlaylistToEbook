            "cites": [
              "ghCSGRgVB_o@3571",
              "ghCSGRgVB_o@3572",
              "ghCSGRgVB_o@3574",
              "mk-6cFebjis@4983",
              "mk-6cFebjis@4986",
              "mk-6cFebjis@4987",
              "mk-6cFebjis@5001",
              "mk-6cFebjis@5004",
              "mk-6cFebjis@5006"
            ]
          },
          {
            "id": "ch02.s10.p05.03",
            "text": "A word’s position also matters for understanding sentence context.",
            "type": "F",
            "cites": [
              "ghCSGRgVB_o@3554",
              "ghCSGRgVB_o@3556",
              "ghCSGRgVB_o@3559",
              "ghCSGRgVB_o@3561",
