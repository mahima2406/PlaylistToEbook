      {
        "id": "ch02.s10.p03",
        "sentences": [
          {
            "id": "ch02.s10.p03.01",
            "text": "A more useful numerical representation is to encode each token as a vector whose dimensions correspond to features.",
            "type": "F",
            "cites": [
              "ghCSGRgVB_o@571",
              "ghCSGRgVB_o@573",
