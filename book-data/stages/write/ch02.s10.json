              "ghCSGRgVB_o@3341",
              "ghCSGRgVB_o@3343",
              "ghCSGRgVB_o@3346"
            ]
          },
          {
            "id": "ch02.s10.p04.06",
            "text": "The key takeaway is that vectors can capture semantic meaning.",
            "type": "F",
            "cites": [
              "ghCSGRgVB_o@830",
              "ghCSGRgVB_o@834",
              "ghCSGRgVB_o@836",
              "mk-6cFebjis@4130",
              "mk-6cFebjis@4132",
              "mk-6cFebjis@4134"
            ]
          },
          {
            "id": "ch02.s10.p04.07",
            "text": "Because these embeddings retain the meaning of words, feeding them into a large language model makes a huge difference compared with feeding one-hot encodings or random token IDs.",
            "type": "F",
            "cites": [
              "ghCSGRgVB_o@940",
