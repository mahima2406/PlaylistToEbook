              "mk-6cFebjis@3934",
              "mk-6cFebjis@3936",
              "mk-6cFebjis@3939"
            ]
          },
          {
            "id": "ch02.s10.p02.03",
            "text": "One-hot encoding has the same limitation: it does not capture semantic relationships between words such as \"dog\" and \"puppy\".",
