              "mk-6cFebjis@5016"
            ]
          },
          {
            "id": "ch02.s10.p05.04",
            "text": "That is why it is advantageous to encode positional information along with semantic meaning.",
            "type": "F",
            "cites": [
              "mk-6cFebjis@5019",
              "mk-6cFebjis@5021",
              "mk-6cFebjis@5023",
