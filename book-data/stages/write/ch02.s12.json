              "mk-6cFebjis@4658"
            ]
          },
          {
            "id": "ch02.s12.p07.04",
            "text": "The input token IDs from the data loader are passed into this token embedding layer to obtain the corresponding embedding vectors.",
            "type": "F",
            "cites": [
