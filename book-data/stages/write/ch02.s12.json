              "ghCSGRgVB_o@2744",
              "ghCSGRgVB_o@2747",
              "ghCSGRgVB_o@2765",
              "ghCSGRgVB_o@2768",
              "ghCSGRgVB_o@2770",
              "mk-6cFebjis@4511",
              "mk-6cFebjis@4513",
              "mk-6cFebjis@4515",
              "mk-6cFebjis@4517",
              "mk-6cFebjis@4520"
            ]
          },
          {
            "id": "ch02.s12.p06.03",
            "text": "You can pass either a single token ID or multiple token IDs to the embedding layer and get the corresponding vectors in one operation.",
            "type": "F",
            "cites": [
              "ghCSGRgVB_o@2774",
              "ghCSGRgVB_o@2776",
