              "ghCSGRgVB_o@3014"
            ]
          },
          {
            "id": "ch02.s12.p06.05",
            "text": "If only certain IDs are needed, passing those IDs to the embedding layer extracts only the corresponding rows from the embedding matrix.",
            "type": "F",
            "cites": [
