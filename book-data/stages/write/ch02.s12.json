          }
        ]
      },
      {
        "id": "ch02.s12.p07",
        "sentences": [
          {
            "id": "ch02.s12.p07.01",
            "text": "The practical GPT-style code example uses the same idea at a larger scale.",
            "type": "C",
            "cites": []
          },
          {
            "id": "ch02.s12.p07.02",
            "text": "A practical embedding layer is created with \"torch.nn.Embedding\" using GPT-2’s vocabulary size of 50,257 and a vector dimension of 256, giving a matrix with 50,257 rows and 256 columns.",
            "type": "F",
            "cites": [
