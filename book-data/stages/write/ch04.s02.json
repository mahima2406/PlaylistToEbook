              "G3-JgHckzjw@2515"
            ]
          },
          {
            "id": "ch04.s02.p03.09",
            "text": "The query-key-value bias setting means no bias term is used when initializing the query, key, and value weight matrices.",
            "type": "F",
            "cites": [
              "7TKCrt--bWI@421",
              "7TKCrt--bWI@424",
